<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <PackageId>BackofficeThemes</PackageId>
    <Product>Backoffice Theme Bundle</Product>
    <Title>Backoffice Theme Bundle</Title>
    <Description>Extra themes for the Umbraco backoffice — including Christmas (theme + snow, lights, tree, Santa hat) and popular editor-style themes.</Description>
    <PackageTags>umbraco plugin package;umbraco-marketplace;umbraco;backoffice;themes;christmas;dracula;neon;cyberpunk;monokai;editor-tools</PackageTags>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Authors>Afreed</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>1.0.3</Version>
    <PackageIcon>assests/logos/logo-white.png</PackageIcon>
    <SignAssembly>False</SignAssembly>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Afreed-cp/Backoffice-Themes</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Afreed@2026</Copyright>
    <PackageProjectUrl>https://github.com/Afreed-cp/Backoffice-Themes</PackageProjectUrl>
    <Tags>umbraco-marketplace</Tags>
    <RequireLicenseAcceptance>false</RequireLicenseAcceptance>
    <PackageOutputPath>$(MSBuildThisFileDirectory)nupkgs</PackageOutputPath>
  </PropertyGroup>

  <!-- Umbraco dependency so marketplace can list and show version compatibility -->
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Core" Version="[17.0.0,)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="assests\logos\logo-white.png">
      <PackagePath>\</PackagePath>
      <Pack>True</Pack>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Don't include the client folder as part of packaging nuget build -->
    <Content Remove="BackofficeThemes\**" />
    <!-- Exclude from default SDK Content so our explicit Include below is the only one (avoids NETSDK1022 duplicate) -->
    <Content Remove="App_Plugins\BackofficeThemes\**" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="App_Plugins\BackofficeThemes\**\*" CopyToOutputDirectory="Always" Pack="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="buildTransitive\**" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>

  <!-- Pack plugin files into package 'content' folder so buildTransitive targets can copy them -->
  <ItemGroup>
    <None Include="App_Plugins\BackofficeThemes\**\*" Pack="true" PackagePath="content\App_Plugins\BackofficeThemes\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
